# Website service
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SESSION_SECRET=
SESSION_DATABASE_URL=
PUBLIC_BASE_URL=
# Use a long random value and keep it stable between deploys.

# Bot service
DISCORD_BOT_TOKEN=
OWNER_IDS=1329092621083086874
OWNER_TOTP_SECRET=
BOT_REPORT_CHANNEL_ID=
BOT_FEEDBACK_CHANNEL_ID=
ENABLE_GUILD_MEMBERS_INTENT=false
DATA_DIR=./data

# AI is disabled by default. Do not enable a provider until age and Discord data-use terms are verified.
AI_ENABLED=false
# Google Gemini (requires separate eligibility and data-use review before any use)
GEMINI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite

# Owner-only developer tools (bot service only)
GITHUB_TOKEN=
RENDER_API_KEY=

# Dashboard-to-bot private control connection (web service + bot service)
BOT_CONTROL_URL=https://uranium-bot.onrender.com
DASHBOARD_API_SECRET=

# Optional self-hosted OpenAI-compatible model endpoint (no vendor token credits; compute/hosting still costs resources).
AI_PROVIDER=gemini
AI_LOCAL_BASE_URL=
AI_LOCAL_MODEL=local-model
AI_LOCAL_API_KEY=
AI_MEMORY_TTL_MS=1800000
AI_MEMORY_MESSAGES=8

# Premium payments (website service): your public UPI ID, for example name@fam. Leave empty to keep payments closed.
PAYMENT_UPI_ID=
PAYMENT_PAYEE_NAME=Uranium
# Premium payments (bot service, optional): channel that also receives the owner approve/reject card.
PAYMENT_NOTIFY_CHANNEL_ID=

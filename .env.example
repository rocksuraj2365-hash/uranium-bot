# Website service
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SESSION_SECRET=
# Dashboard sessions use PostgreSQL. Set SESSION_DATABASE_URL to your Supabase connection string,
# or reuse DATABASE_URL if it is already configured on the web service.
SESSION_DATABASE_URL=
# Optional: set PGSSLMODE=disable only for a trusted local PostgreSQL instance.
PUBLIC_BASE_URL=
# Use a long random value and keep it stable between deploys.

# Bot service
DISCORD_BOT_TOKEN=
OWNER_IDS=1329092621083086874
OWNER_TOTP_SECRET=
BOT_REPORT_CHANNEL_ID=
BOT_FEEDBACK_CHANNEL_ID=
ENABLE_GUILD_MEMBERS_INTENT=false
DATA_DIR=./data

# AI is disabled by default. Do not enable a provider until age and Discord data-use terms are verified.
AI_ENABLED=false
# Google Gemini (requires separate eligibility and data-use review before any use)
GEMINI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_FALLBACK_MODELS=gemini-3.6-flash,gemini-2.5-flash

# Owner-only developer tools (bot service only)
GITHUB_TOKEN=
RENDER_API_KEY=

# Dashboard-to-bot private control connection (web service + bot service)
BOT_CONTROL_URL=https://uranium-bot.onrender.com
DASHBOARD_API_SECRET=

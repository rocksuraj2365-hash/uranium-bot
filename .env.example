# Website service
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SESSION_SECRET=
PUBLIC_BASE_URL=
# Use a long random value and keep it stable between deploys.

# Bot service
DISCORD_BOT_TOKEN=
OWNER_IDS=1329092621083086874
OWNER_TOTP_SECRET=
BOT_REPORT_CHANNEL_ID=
BOT_FEEDBACK_CHANNEL_ID=
ENABLE_GUILD_MEMBERS_INTENT=false
DATA_DIR=./data

# AI uses only Uranium's local-model adapter. Keep disabled until the model host, licence,
# age eligibility, and Discord data handling have been reviewed by an eligible operator.
AI_ENABLED=false

# Owner-only developer tools (bot service only)
GITHUB_TOKEN=
RENDER_API_KEY=

# Dashboard-to-bot private control connection (web service + bot service)
BOT_CONTROL_URL=https://uranium-bot.onrender.com
DASHBOARD_API_SECRET=

# Optional self-hosted OpenAI-compatible model endpoint (no vendor token credits; compute/hosting still costs resources).
AI_PROVIDER=local
AI_LOCAL_BASE_URL=
AI_LOCAL_MODEL=local-model
AI_LOCAL_API_KEY=
AI_MEMORY_TTL_MS=1800000
AI_MEMORY_MESSAGES=8

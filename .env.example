# Website service
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SESSION_SECRET=
PUBLIC_BASE_URL=
# Use a long random value and keep it stable between deploys.

# Bot service
DISCORD_BOT_TOKEN=
OWNER_IDS=1329092621083086874
OWNER_TOTP_SECRET=
BOT_REPORT_CHANNEL_ID=
BOT_FEEDBACK_CHANNEL_ID=
ENABLE_GUILD_MEMBERS_INTENT=false
DATA_DIR=./data

# AI is disabled by default. An eligible operator must review provider age and data-use terms first.
AI_ENABLED=false
# Provider options: gemini (legacy), openrouter, or local. Keep AI_ENABLED=false until reviewed.
AI_PROVIDER=gemini
# OpenRouter uses the OpenAI-compatible API. Free routing model: openrouter/free.
OPENROUTER_API_KEY=
# OpenRouter has separate settings so existing Gemini/local configuration is preserved.
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_FALLBACK_MODELS=
# Legacy Gemini configuration (only used when AI_PROVIDER=gemini).
GEMINI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_FALLBACK_MODELS=gemini-3.6-flash,gemini-2.5-flash

# Owner-only developer tools (bot service only)
GITHUB_TOKEN=
RENDER_API_KEY=

# Dashboard-to-bot private control connection (web service + bot service)
BOT_CONTROL_URL=https://uranium-bot.onrender.com
DASHBOARD_API_SECRET=

# Optional self-hosted OpenAI-compatible model endpoint (no vendor token credits; compute/hosting still costs resources).
AI_PROVIDER=gemini
AI_LOCAL_BASE_URL=
AI_LOCAL_MODEL=local-model
AI_LOCAL_API_KEY=
AI_MEMORY_TTL_MS=1800000
AI_MEMORY_MESSAGES=8
